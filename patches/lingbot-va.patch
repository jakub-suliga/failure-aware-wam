+    @torch.no_grad()
+    def _decode_latents_uint8_on(self, latents, device):
+        vae_device = next(self.vae.parameters()).device
+        self.vae.to(device)
+        try:
+            vae = self.vae
+            latents = latents[None].to(device, vae.dtype)
+            mean = torch.tensor(vae.config.latents_mean).view(1, -1, 1, 1, 1).to(latents)
+            std = torch.tensor(vae.config.latents_std).view(1, -1, 1, 1, 1).to(latents)
+            # Same causal frame-by-frame loop as AutoencoderKLWan._decode, but each decoded chunk goes to the CPU
+            # right away: decoding a whole long episode on the GPU runs out of memory next to the simulator.
+            vae.clear_cache()
+            x = vae.post_quant_conv(latents * std + mean)
+            chunks = []
+            for i in range(x.shape[2]):
+                vae._conv_idx = [0]
+                out = vae.decoder(x[:, :, i:i + 1], feat_cache=vae._feat_map, feat_idx=vae._conv_idx,
+                                  first_chunk=(i == 0))
+                if vae.config.patch_size is not None:
+                    out = unpatchify(out, patch_size=vae.config.patch_size)
+                out = ((out[0].float().clamp(-1, 1) + 1) * 127.5).round().to(torch.uint8)  # 3, t, H, W
