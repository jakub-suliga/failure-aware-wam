+class SimStateRecorder:
+    """Simulation ground truth per env step: end-effector poses, gripper values, object poses and contact impulses
+    (object vs. left gripper, right gripper, table). Used offline to label failures (missed grasp, drop, misplace)."""
+
+    def __init__(self, task_env):
+        self.env = task_env
+        robot = task_env.robot
+        self.gripper_links = {
+            arm: set(getattr(robot, f"{arm}_fix_gripper_name")) |
+                 {g[0].child_link.get_name() for g in getattr(robot, f"{arm}_gripper")}
+            for arm in ("left", "right")
+        }
+        self.objects = [e for e in task_env.scene.get_all_actors()
+                        if e.get_name() not in ("", "table", "wall", "ground")]
+        self.object_names = [e.get_name() for e in self.objects]
+        self.object_index = {name: i for i, name in reversed(list(enumerate(self.object_names)))}
+        self.rows = []
+
+    def record(self, env_step):
+        n = len(self.objects)
+        contact = {k: np.zeros(n) for k in ("left_gripper", "right_gripper", "table")}
+        for c in self.env.scene.get_contacts():
+            names = (c.bodies[0].entity.name, c.bodies[1].entity.name)
+            impulse = float(sum(np.linalg.norm(p.impulse) for p in c.points))
+            if impulse <= 0:
+                continue
+            for obj, other in (names, names[::-1]):
+                i = self.object_index.get(obj)
+                if i is None:
+                    continue
+                if other in self.gripper_links["left"]:
+                    contact["left_gripper"][i] += impulse
+                elif other in self.gripper_links["right"]:
+                    contact["right_gripper"][i] += impulse
+                elif other == "table":
+                    contact["table"][i] += impulse
+        poses = [e.get_pose() for e in self.objects]
+        self.rows.append(dict(
+            env_step=env_step,
+            wall_time=time.time(),
+            left_ee_pose=np.asarray(self.env.get_arm_pose("left"), dtype=np.float64),
+            right_ee_pose=np.asarray(self.env.get_arm_pose("right"), dtype=np.float64),
+            left_gripper=self.env.robot.get_left_gripper_val(),
+            right_gripper=self.env.robot.get_right_gripper_val(),
+            object_pose=np.array([np.concatenate([p.p, p.q]) for p in poses]).reshape(n, 7),
+            **{f"contact_{k}": v for k, v in contact.items()},
+        ))
+
+    def save(self, h5):
+        g = h5.create_group("sim")
+        g.attrs["object_names"] = self.object_names
+        g.attrs["gripper_convention"] = "normalized gripper command: 1 = open, 0 = closed (open > 0.8, closed < 0.2)"
+        g.attrs["pose_convention"] = "x, y, z, qw, qx, qy, qz (sapien) for objects; RoboTwin endpose for arms"
+        for key in self.rows[0]:
+            g.create_dataset(key, data=np.stack([np.asarray(r[key]) for r in self.rows]), compression="gzip")
+
+
+class EpisodeRecorder:
+    """Collects raw frames, planned and executed actions of one episode, with env steps and wall-clock times.
+
+    Latent index convention (shared with the server's pred/obs latents): frame 0 is the initial observation
+    (latent 0); afterwards every 4 frames form one latent frame, i.e. frame f >= 1 belongs to latent (f - 1) // 4 + 1.
+    """
+
+    def __init__(self):
+        self.frames = {k: [] for k in CAM_KEYS}
+        self.frame_state, self.frame_env_step, self.frame_wall_time = [], [], []
+        self.plans, self.plan_frame_st_id, self.plan_env_step, self.plan_wall_time = [], [], [], []
+        self.executed = []
+
+    def add_frame(self, obs, env_step):
+        for k in CAM_KEYS:
+            self.frames[k].append(obs[k])
+        self.frame_state.append(np.asarray(obs["observation.state"], dtype=np.float64))
+        self.frame_env_step.append(env_step)
+        self.frame_wall_time.append(time.time())
+
+    def add_plan(self, action, frame_st_id, env_step):
+        self.plans.append(np.asarray(action, dtype=np.float32))
+        self.plan_frame_st_id.append(-1 if frame_st_id is None else int(frame_st_id))
+        self.plan_env_step.append(env_step)
+        self.plan_wall_time.append(time.time())
+        return len(self.plans) - 1
+
+    def add_executed(self, raw_action, ee_action, chunk_id, latent_index, action_in_frame, step_before, step_after):
+        self.executed.append(dict(raw_action=np.asarray(raw_action, dtype=np.float64),
+                                  ee_action=np.asarray(ee_action, dtype=np.float64),
+                                  chunk_id=chunk_id, latent_index=latent_index, action_in_frame=action_in_frame,
+                                  env_step=step_after, executed=step_after > step_before, wall_time=time.time()))
+
+    def save(self, episode_dir, h5):
+        """Raw frames as real_<camera>.mp4; timing, state and actions into the open episode.h5."""
+        for k, frames in self.frames.items():
+            write_mp4(episode_dir / f"real_{k.split('.')[-1]}.mp4", frames)
+        n = len(self.frame_env_step)
+        g = h5.create_group("frames")
+        g["env_step"] = np.array(self.frame_env_step)
+        g["wall_time"] = np.array(self.frame_wall_time)
+        g["latent_index"] = np.array([0] + [(f - 1) // 4 + 1 for f in range(1, n)])
+        g["state"] = np.stack(self.frame_state)
+
+        ex = self.executed
+        g = h5.create_group("actions")
+        g.attrs["planned_layout"] = "one entry per model call: (action_dim, frames_per_chunk, actions_per_frame)"
+        g["planned"] = np.stack(self.plans)
+        g["planned_frame_st_id"] = np.array(self.plan_frame_st_id)
+        g["planned_env_step"] = np.array(self.plan_env_step)
+        g["planned_wall_time"] = np.array(self.plan_wall_time)
+        # one entry per take_action call, in order; executed=False if the env ignored it (success or step limit)
+        g["executed_raw_action"] = np.stack([e["raw_action"] for e in ex])
+        g["executed_ee_action"] = np.stack([e["ee_action"] for e in ex])
+        for key in ("chunk_id", "latent_index", "action_in_frame", "env_step", "executed", "wall_time"):
+            g[f"executed_{key}"] = np.array([e[key] for e in ex])
+
