+    m2.adapter_path = c.get("meta_adapter")
+    if c.get("gate") in ("t1", "t2", "t5"):  # time-aligned / NN-aligned error of the (context) attempt -> strength
+        m2.adapter_gate = dict(ref_ep=str(src), mode=c["gate"], offset=icl_snap.reset_offset(src, r_src))
