+    by_chunk = {r["chunk"]: r for r in snap_rec if r["snap"] is not None}
+    k = int(c.get("k", 2))
+    r = max(1, close - k + 1)
+    r = max([x for x in by_chunk if x <= r] or [min(by_chunk)])
+    ctx, src, L_src = c.get("ctx", "C2"), parent_dir, L
+    r_src = r
+    if c.get("foreign") and not parent_ok:
+        from fawam.icl_snap import param_of
