+            info["conts"].append(dict(k=k, reset_chunk=r, skipped="reset point before the episode start"))
+            continue
+        snap = by_chunk[r]["snap"]
+        snap.restore()
+        poses, phase, ok = replan_poses(TASK_ENV, generic=True)
+        rec = dict(k=k, reset_chunk=r, reset_step=by_chunk[r]["step"], phase=phase, planner_ok=bool(ok))
+        if ok and poses is not None and len(poses) > 1:
