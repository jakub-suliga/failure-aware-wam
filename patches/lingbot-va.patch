+    # Camera regions of the robotwin_tshape latent canvas (C, T, 24, 20): wrists (half resolution) side by side
+    # on top, head camera below. Hidden-state tokens use the same layout on the 2x2-patched grid (12 x 10).
+    LATENT_CAM_SLICES = {
+        'cam_high': (slice(8, None), slice(None)),
+        'cam_left_wrist': (slice(0, 8), slice(0, 10)),
+        'cam_right_wrist': (slice(0, 8), slice(10, None)),
+    }
+    TOKEN_CAM_SLICES = {
+        'cam_high': (slice(4, None), slice(None)),
+        'cam_left_wrist': (slice(0, 4), slice(0, 5)),
+        'cam_right_wrist': (slice(0, 4), slice(5, None)),
+    }
+
+    @classmethod
+    def _split_cams(cls, latents):
+        """(..., H, W) latent canvas -> {camera: (..., h, w)}."""
+        return {cam: latents[..., hs, ws] for cam, (hs, ws) in cls.LATENT_CAM_SLICES.items()}
+
+    def _hidden_hook(self, layer, module, inputs, output):
+        if self._hidden_capture is None:
+            return
+        num_frames = self._hidden_capture['num_frames']
+        tokens = output[0].detach().float()  # conditional branch when CFG doubles the batch; (F*12*10, D)
+        grid = tokens.reshape(num_frames, self.latent_height // 2, self.latent_width // 2, -1)
+        pooled = torch.stack([grid[:, hs, ws].mean(dim=(1, 2)) for hs, ws in self.TOKEN_CAM_SLICES.values()],
+                             dim=1)  # F, num_cams, D
+        self._hidden_capture['layers'][layer] = pooled.half().cpu()
+
+    def _run_with_hidden_capture(self, num_frames, fn):
+        self._hidden_capture = dict(num_frames=num_frames, layers={})
+        try:
+            out = fn()
+            captured = self._hidden_capture['layers']
+        finally:
+            self._hidden_capture = None
+        # F, num_layers, num_cams, D
+        return out, torch.stack([captured[layer] for layer in self.record_hidden_layers], dim=1)
+
